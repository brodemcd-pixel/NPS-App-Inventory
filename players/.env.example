# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://players:players@localhost:5432/players
TEST_DATABASE_URL=postgresql+asyncpg://players:players@localhost:5432/players_test

# --- Security ------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string

# --- AI assistant (optional: offline rule-based router used when key empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Embeddings: "lite" (deterministic, no downloads) or "e5" (e5-small via
#     sentence-transformers; pip install -r requirements-optional.txt)
PLAYERS_ENCODER=lite

# --- URLs ----------------------------------------------------------------
WEB_BASE_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Slack integration (optional; bot disabled when unset) ----------------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
